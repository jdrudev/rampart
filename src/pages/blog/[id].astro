---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { siteCopy } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.data.confluence_id)
    .map((post) => ({ params: { id: post.data.confluence_id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} | Rampart`} description={post.data.description}>
  <div class="article-layout shell">
    <aside class="toc" aria-label="On this page"><p class="toc-title">On this page</p><nav><ul id="article-toc"></ul></nav></aside>
    <article class="article"><a class="back" href={`${import.meta.env.BASE_URL}blogs/`}>← {siteCopy.posts.backLink}</a><header><p class="eyebrow">{post.data.tags.join(' / ')}</p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}</time></header><div class="prose"><Content /></div></article>
  </div>
  <div id="copy-toast" class="copy-toast" role="status" aria-live="polite"></div>
</BaseLayout>
<script>
  const article = document.querySelector<HTMLElement>('.article');
  const toc = document.querySelector<HTMLElement>('#article-toc');
  const toast = document.querySelector<HTMLElement>('#copy-toast');
  const slugify = (text: string) => text.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-');
  const notify = (message: string) => { if (!toast) return; toast.textContent = message; toast.classList.add('visible'); window.setTimeout(() => toast.classList.remove('visible'), 1800); };
  const copy = async (value: string) => { await navigator.clipboard.writeText(value); notify('Copied to clipboard'); };
  if (article && toc) {
    const headings = [...article.querySelectorAll<HTMLElement>('.prose h2, .prose h3')];
    headings.forEach((heading, index) => {
      heading.id ||= `${slugify(heading.textContent ?? 'section')}-${index}`;
      const item = document.createElement('li');
      item.dataset.level = heading.tagName.slice(1);
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? '';
      item.append(link); toc.append(item);
    });
    if (!headings.length) toc.closest('.toc')?.remove();
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { toc.querySelectorAll('a').forEach((link) => link.classList.toggle('active', link.hash === `#${entry.target.id}`)); } }), { rootMargin: '-15% 0px -70% 0px' });
    headings.forEach((heading) => observer.observe(heading));
  }
  article?.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
    const source = block.textContent ?? '';
    const button = document.createElement('button'); button.className = 'copy-button'; button.type = 'button'; button.textContent = 'Copy'; button.addEventListener('click', () => copy(source)); block.append(button);
  });
  article?.querySelectorAll<HTMLElement>('.prose code').forEach((code) => {
    if (code.parentElement?.tagName === 'PRE') return;
    code.title = 'Copy code'; code.tabIndex = 0; const copyCode = () => copy(code.textContent ?? ''); code.addEventListener('click', copyCode); code.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); copyCode(); } });
  });
</script>
<style>
  .prose :global(code) { white-space: nowrap; }
  .prose :global(pre) { overflow-x: hidden; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
  .prose :global(pre code) { white-space: inherit; }
  @media (max-width: 900px) { .article-layout { display: block; width: min(700px, calc(100% - 40px)); }.toc { display: none; } }
</style>
<style>
  .article-layout { width: min(1060px, calc(100% - 48px)); grid-template-columns: 190px minmax(0, 760px); gap: 64px; }
  .toc nav { display: block; }
  .toc-title { padding-bottom: 12px; border-bottom: 1px solid var(--line); letter-spacing: .08em; }
  .toc ul { gap: 0; border-left: 0; }
  .toc li { border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent); }
  .toc a { position: relative; padding: 9px 10px 9px 0; transition: color .2s, background .2s; }
  .toc li[data-level="3"] a { padding-left: 14px; }
  .toc li[data-level="4"] a { padding-left: 28px; }
  .toc a::before { position: absolute; left: 0; top: 50%; width: 3px; height: 3px; border-radius: 50%; background: var(--line); content: ''; transform: translateY(-50%); }
  .toc li[data-level="3"] a::before { left: 5px; }
  .toc li[data-level="4"] a::before { left: 19px; }
  .toc a.active { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .article header { margin: 78px 0 72px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .article h1 { max-width: 760px; margin: 18px 0 22px; text-wrap: balance; }
  .article-description { max-width: 620px; }
  .article time { display: block; margin-top: 22px; }
  .prose { font-size: 1.05rem; line-height: 1.85; }
  .prose :global(p) { margin: 0 0 1.35em; }
  .prose :global(h2) { margin: 3.5em 0 1em; padding-top: 1.15em; border-top: 1px solid var(--line); color: var(--deep); font-size: 1.95rem; letter-spacing: -.045em; scroll-margin-top: 28px; }
  .prose :global(h3) { margin: 2.4em 0 .85em; color: var(--deep); font-size: 1.38rem; letter-spacing: -.025em; scroll-margin-top: 28px; }
  .prose :global(ul), .prose :global(ol) { margin: 1.2em 0 1.6em; padding-left: 1.6em; }
  .prose :global(li) { padding-left: .35em; margin: .35em 0; }
  .prose :global(li)::marker { color: var(--accent); }
  .prose :global(.contains-task-list) { padding-left: 0; list-style: none; }
  .prose :global(.task-list-item) { display: flex; gap: .65em; align-items: flex-start; padding-left: 0; }
  .prose :global(.task-list-item input) { flex: 0 0 auto; width: 1em; height: 1em; margin-top: .42em; accent-color: var(--accent); }
  .prose :global(a) { text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose :global(code) { box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--accent) 35%, transparent); }
  .prose :global(pre) { margin: 1.8em 0; padding: 48px 22px 22px; overflow-x: hidden; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; border-color: color-mix(in srgb, var(--accent) 25%, var(--line)); border-radius: 6px; background: #0a0f15; box-shadow: 0 14px 35px rgba(0, 0, 0, .22); }
  .prose :global(pre)::before { position: absolute; top: 0; right: 0; left: 0; height: 32px; border-bottom: 1px solid var(--line); background: var(--panel); color: var(--muted); content: 'CODE'; font: 500 .58rem/32px var(--mono); letter-spacing: .12em; padding-left: 16px; }
  .prose :global(pre)::after { position: absolute; top: 11px; left: 72px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: -14px 0 #c98585, 14px 0 #c7a567; content: ''; }
  .copy-button { top: 7px; right: 10px; z-index: 1; border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); background: transparent; text-transform: uppercase; letter-spacing: .05em; }
  .copy-button:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .prose :global(blockquote) { margin: 2em 0; background: color-mix(in srgb, var(--panel) 68%, transparent); }
  .prose :global(.callout) { margin: 2em 0; border-color: color-mix(in srgb, currentColor 32%, var(--line)); border-left-width: 3px; background: color-mix(in srgb, currentColor 7%, var(--panel)); box-shadow: 0 10px 28px rgba(0, 0, 0, .12); }
  .prose :global(.callout > strong) { letter-spacing: .1em; }
  .prose :global(details.expand) { margin: 2em 0; border-color: color-mix(in srgb, var(--accent) 28%, var(--line)); background: color-mix(in srgb, var(--panel) 78%, transparent); }
  .prose :global(details.expand summary) { padding: 2px 0; }
  .prose :global(.callout)::before { display: grid; place-items: center; border-radius: 4px; font-size: .68rem; font-weight: 700; }
  .prose :global(.callout-info)::before { content: 'i'; }
  .prose :global(.callout-note)::before { content: '?'; }
  .prose :global(.callout-success)::before { content: '✓'; }
  .prose :global(.callout-warning)::before { content: '!'; }
  .prose :global(.callout-error)::before { content: '×'; }
  .prose :global(.decision-item) { display: flex; align-items: flex-start; gap: 12px; margin: 12px 0; padding: 12px 14px; border: 1px solid var(--line); background: color-mix(in srgb, var(--panel) 58%, transparent); }
  .prose :global(.decision-icon) { display: grid; flex: 0 0 22px; place-items: center; width: 22px; height: 22px; border: 1px solid var(--accent); color: var(--accent); font: 500 .8rem/1 var(--mono); }
  .prose :global(.decision-item:nth-child(2) .decision-icon) { border-color: var(--muted); color: var(--muted); }
  .prose :global(table) { margin: 2em 0; border: 1px solid var(--line); background: color-mix(in srgb, var(--panel) 42%, transparent); box-shadow: 0 10px 25px rgba(0, 0, 0, .1); }
  .prose :global(th), .prose :global(td) { min-width: 140px; border-color: var(--line); }
  .prose :global(td) { color: color-mix(in srgb, var(--ink) 88%, var(--muted)); }
  .prose :global(tr:nth-child(even) td) { background: color-mix(in srgb, var(--panel) 38%, transparent); }
  @media (max-width: 900px) { .article-layout { width: min(760px, calc(100% - 40px)); } }
  @media (max-width: 640px) { .article-layout { width: calc(100% - 32px); padding-top: 42px; }.article header { margin: 58px 0 48px; padding-bottom: 24px; }.article h1 { font-size: clamp(2.8rem, 15vw, 4.5rem); }.prose { font-size: 1rem; }.prose :global(h2) { margin-top: 2.8em; font-size: 1.7rem; }.prose :global(pre) { margin-inline: -4px; }.copy-toast { right: 16px; bottom: 16px; } }
</style>