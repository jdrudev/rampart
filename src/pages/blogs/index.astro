---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Posts | Rampart" description="Security engineering notes, lessons learned, and practical systems thinking.">
  <section class="blog-shell shell">
    <p class="eyebrow">Posts</p>
    <h1>Security engineering<br />in practice.</h1>
    <div class="controls"><label class="search"><span>⌕</span><input id="post-search" type="search" placeholder="Search the archive" /></label><div class="filters"><button class="filter active" data-tag="all">All</button>{tags.map((tag) => <button class="filter" data-tag={tag}>{tag}</button>)}</div></div>
    <div class="archive">{posts.map((post) => <a class="archive-row" data-title={post.data.title.toLowerCase()} data-tags={post.data.tags.join(',')} href={`${base}blogs/${post.id}/`}><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div></div><span class="arrow">↗</span></a>)}</div>
    <p id="empty" class="empty" hidden>No notes match that search.</p>
  </section>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#post-search');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('.archive-row')];
  const empty = document.querySelector<HTMLElement>('#empty');
  let selected = 'all';
  function filterPosts() { const query = search?.value.trim().toLowerCase() ?? ''; let visible = 0; rows.forEach((row) => { const text = row.textContent?.toLowerCase() ?? ''; const matches = (!query || text.includes(query)) && (selected === 'all' || row.dataset.tags?.split(',').includes(selected)); row.hidden = !matches; if (matches) visible += 1; }); if (empty) empty.hidden = visible !== 0; }
  search?.addEventListener('input', filterPosts);
  buttons.forEach((button) => button.addEventListener('click', () => { selected = button.dataset.tag ?? 'all'; buttons.forEach((item) => item.classList.toggle('active', item === button)); filterPosts(); }));
</script>
<style>
  .blog-shell { padding: 80px 0 120px; }.blog-shell > h1 { margin: 20px 0 60px; font-size: clamp(3rem, 6.5vw, 6rem); line-height: .98; letter-spacing: -.07em; }.controls { display: flex; justify-content: space-between; gap: 25px; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 16px; }.search { display: flex; align-items: center; gap: 10px; min-width: 270px; color: var(--accent); font-size: 1.15rem; }.search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font: .72rem var(--mono); }.filters { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }.filter { padding: 6px 8px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; font: .6rem var(--mono); text-transform: uppercase; }.filter.active, .filter:hover { border-color: var(--accent); background: var(--accent); color: var(--paper); }.archive-row { display: grid; grid-template-columns: 130px 1fr 35px; gap: 20px; padding: 27px 0; border-bottom: 1px solid var(--line); text-decoration: none; }.archive-row[hidden] { display: none; }.archive-row:hover h2 { color: var(--accent); }.archive-row time { color: var(--muted); font: .66rem var(--mono); text-transform: uppercase; }.archive-row h2 { margin: -4px 0 8px; font-size: 1.45rem; letter-spacing: -.04em; transition: color .2s; }.archive-row p { max-width: 620px; margin: 0 0 15px; color: var(--muted); line-height: 1.55; }.tags { display: flex; gap: 6px; flex-wrap: wrap; }.tags span { color: var(--muted); font: .6rem var(--mono); text-transform: uppercase; }.arrow { color: var(--accent); font-size: 1.25rem; text-align: right; }.empty { padding: 40px 0; color: var(--muted); font: .78rem var(--mono); }
  @media (max-width: 700px) { .blog-shell { padding-top: 55px; }.controls { display: block; }.search { margin-bottom: 20px; }.filters { justify-content: flex-start; }.archive-row { grid-template-columns: 1fr 20px; gap: 10px; }.archive-row time { grid-column: 1 / -1; }.archive-row h2 { font-size: 1.4rem; } }
</style>